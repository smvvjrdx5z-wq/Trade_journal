# ---------------------------------------------------------------------------
# Notion
# ---------------------------------------------------------------------------
# Create an internal integration at https://www.notion.so/my-integrations,
# then share the "MT5 Trade Journal" page with it (••• > Connections > your integration).
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Database IDs — already filled in for your workspace.
NOTION_TRADES_DB=c3e79427d07f4d29a8e453eaa420a6fc
NOTION_ACCOUNTS_DB=e29136de018b4d689d68175b3587261f
NOTION_DAILY_DB=38eb40b10cb5478a95bb8e368341b12e
NOTION_PLAYBOOKS_DB=8a8743f4cb8641449792f45273535da4
NOTION_TAGS_DB=5ab1dca9b45c49b4a0e45ae80711698b
NOTION_PERFORMANCE_DB=8c49b655077d45f58b5cba0ecb349f29

# Bump this only if the file-upload endpoint rejects the default.
NOTION_VERSION=2022-06-28

# ---------------------------------------------------------------------------
# Bridge
# ---------------------------------------------------------------------------
# The EA prints this exact path to the Experts log when it starts.
# Typically: C:\Users\<you>\AppData\Roaming\MetaQuotes\Terminal\<hash>\MQL5\Files\NotionJournal
BRIDGE_SPOOL_DIR=C:\Users\you\AppData\Roaming\MetaQuotes\Terminal\XXXXXXXX\MQL5\Files\NotionJournal

# Timezone used for the journal calendar, sessions and day grouping.
BRIDGE_TIMEZONE=Europe/Berlin

# Assumed risk when a trade carried no stop loss, as a fraction of balance.
BRIDGE_DEFAULT_RISK_PCT=0.01

# Net P&L within +/- this counts as breakeven rather than a win or loss.
BRIDGE_BREAKEVEN_THRESHOLD=0.5

# Flag any performance scope with fewer trades than this as statistically thin.
BRIDGE_MIN_SAMPLE_SIZE=20

# Seconds between spool checks in `watch` mode.
BRIDGE_POLL_SECONDS=5

# Set to true to compute everything but write nothing to Notion.
BRIDGE_DRY_RUN=false
