# ---------------------------------------------------------------------------
# Supabase — copy from your project's Settings > API page
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Server-only. Required by /api/ingest (the MT5 bridge endpoint) so it can
# resolve an ingest token to a user without a browser session. Never expose
# this in the client — it bypasses row level security.
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
